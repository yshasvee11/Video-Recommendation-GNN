# =============================================================================
# Gitignore for Video-Recommendation-GNN
# =============================================================================

# Byte-compiled / Python cache files
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.bak

# Model checkpoints & large binary weights (avoid bloat & upload timeouts)
checkpoints/
*.pt
*.pth
*.bin
*.ckpt

# Google Colab temporary archives & runtime caches
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints
.colab/
vynora2_colab_bundle.zip
vynora2_trained_results.zip
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.npy
*.npz
*.pkl
*.pickle

# Logs and runtime outputs
*.log
logs/
wandb/
runs/

# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Editor & IDE artifacts
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
